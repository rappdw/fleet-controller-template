{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "out=$(\"$CLAUDE_PROJECT_DIR/bin/mailbox-unanswered\"); [ -n \"$out\" ] && printf 'In-container mailbox: unanswered messages at session start:\\n%s\\n' \"$out\"; exit 0",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/bin/mailbox-watch\"",
            "asyncRewake": true,
            "timeout": 86400
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/bin/mailbox-watch\"",
            "asyncRewake": true,
            "timeout": 86400
          }
        ]
      }
    ]
  }
}
